{
  "name": "flowcrafter-ui",
  "private": true,
  "version": "0.23.1",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "concurrently \"node server.js\" \"vite --host 0.0.0.0 --port 5173\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "start": "node server.js",
    "test": "npx playwright test",
    "test:real": "set -a && [ -f .env ] && . ./.env; set +a && PW_MOCK=0 PW_PASSWORD=${PW_PASSWORD:?'PW_PASSWORD fehlt. PW_PASSWORD über die .env hinterlegen'} npx playwright test",
    "test:report": "npx playwright show-report",
    "upgrade": "npm_config_yes=true && npx npm-check-updates -u && npm install --force"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.98.0",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "codemirror": "^6.0.2",
    "cytoscape": "^3.33.4",
    "cytoscape-dagre": "^3.0.0",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.0",
    "concurrently": "^9.2.1",
    "daisyui": "^5.5.20",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "pngjs": "^7.0.0",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.3.0",
    "vite": "^8.0.14"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "^npm@11.12.1"
}
